<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SowBroadcast.App.Views.AboutWindow"
        Title="About SOW Broadcast"
        Icon="avares://SOWBroadcast/Assets/Brand/app-icon-256.png"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel>
    <!-- Header band: the main logo on the brand gradient -->
    <Border Classes="header" Padding="24,22">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <Image Source="avares://SOWBroadcast/Assets/Brand/paalogo-768.png" Width="150" Height="150" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Classes="h1" HorizontalAlignment="Center" Text="SOW BROADCAST" />
        <TextBlock x:Name="VersionText" Classes="result" FontSize="20" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Margin="24,18,24,20" Spacing="12">
      <TextBlock TextWrapping="Wrap" Text="Broadcast control for Suomi OW ry's Overwatch 2 streams." />

      <StackPanel Spacing="2">
        <TextBlock Classes="label" Text="PROGRAM FOLDER" />
        <TextBlock x:Name="ProgramText" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="2">
        <TextBlock Classes="label" Text="DATA FOLDER" />
        <TextBlock x:Name="DataText" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="2">
        <TextBlock Classes="label" Text="LOG FOLDER" />
        <TextBlock x:Name="LogText" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Open program folder" Click="OnOpenProgram" />
        <Button Content="Open data folder" Click="OnOpenData" />
        <Button Content="Open log folder" Click="OnOpenLogs" />
        <Button Classes="primary" Content="Close" MinWidth="90" Click="OnClose" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
