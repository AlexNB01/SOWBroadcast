<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SowBroadcast.App.ViewModels"
        x:Class="SowBroadcast.App.Views.ControlSettingsWindow"
        x:DataType="vm:ControlSettingsViewModel"
        Title="Hotkeys, remote control and automation"
        Icon="avares://SOWBroadcast/Assets/Brand/app-icon-256.png"
        Width="760" Height="720" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Problems}" IsVisible="{Binding !CanSave}" Foreground="{DynamicResource SowErrorBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Click="OnCancel" />
        <Button Classes="primary" Content="Save" MinWidth="100" IsEnabled="{Binding CanSave}" Click="OnSave" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="REMOTE CONTROL (STREAM DECK, COMPANION)" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Buttons call this address on this computer. The token keeps other programs and web pages from pressing them; keep it private." />
            <TextBlock Classes="label" Text="TOKEN" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding Token}" IsReadOnly="True" FontFamily="Consolas, Courier New, monospace" />
              <Button Grid.Column="1" Content="Copy" Click="OnCopyToken" />
              <Button Grid.Column="2" Content="New token" Command="{Binding NewTokenCommand}" />
            </Grid>
            <TextBlock Classes="label" Text="EXAMPLE (TEAM 1 SCORE +1)" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding ExampleUrl}" IsReadOnly="True" FontFamily="Consolas, Courier New, monospace" />
              <Button Grid.Column="1" Content="Copy" Click="OnCopyExample" />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="GET or POST /api/control/&lt;command&gt;?token=…  Add &amp;publish=1 to send to the overlays right after the command. Answers 200 done, 409 could not do it, 404 unknown command. GET /api/control lists the commands." />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="AUTOMATION" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Optional helpers, all off until you switch them on. They change what you see here; the overlays still get it with Update. They stand aside while SOWDraft fills the match or the bracket." />
            <CheckBox IsChecked="{Binding TeamScoreFromMaps}" Content="Team score = maps won (finished maps)" />
            <CheckBox IsChecked="{Binding CompleteMaps}" Content="Finish a map when a team has the points that win it (the next map becomes current)" />
            <StackPanel Margin="28,0,0,0" Spacing="6" IsEnabled="{Binding CompleteMaps}">
              <TextBlock Classes="muted" Text="Points that win a map (0 = not decided by points; finish those maps yourself):" />
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,4">
                  <TextBlock Text="Control" VerticalAlignment="Center" />
                  <NumericUpDown MinWidth="90" Minimum="0" Maximum="9" FormatString="0" Value="{Binding ControlPoints}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,4">
                  <TextBlock Text="Flashpoint" VerticalAlignment="Center" />
                  <NumericUpDown MinWidth="90" Minimum="0" Maximum="9" FormatString="0" Value="{Binding FlashpointPoints}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,4">
                  <TextBlock Text="Push" VerticalAlignment="Center" />
                  <NumericUpDown MinWidth="90" Minimum="0" Maximum="9" FormatString="0" Value="{Binding PushPoints}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,4">
                  <TextBlock Text="Escort" VerticalAlignment="Center" />
                  <NumericUpDown MinWidth="90" Minimum="0" Maximum="9" FormatString="0" Value="{Binding EscortPoints}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,4">
                  <TextBlock Text="Hybrid" VerticalAlignment="Center" />
                  <NumericUpDown MinWidth="90" Minimum="0" Maximum="9" FormatString="0" Value="{Binding HybridPoints}" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>
            <CheckBox IsChecked="{Binding AdvanceWinners}" Content="Bracket: move the winner of a match to the next round" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsEnabled="{Binding AdvanceWinners}">
              <TextBlock Text="Matches are best of" VerticalAlignment="Center" />
              <NumericUpDown MinWidth="90" Minimum="1" Maximum="9" FormatString="0" Value="{Binding BestOf}" />
              <TextBlock Classes="muted" Text="(a BO label from a tournament link wins over this)" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="HOTKEYS" />
            <CheckBox IsChecked="{Binding GlobalHotkeys}"
                      Content="Work in every program (OBS, the game), not only in this window" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Click a box and press the keys. Use Ctrl, Alt or Win with a key so typing is never mistaken for a command; function keys work alone." />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                  <Grid ColumnDefinitions="*,200,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Gesture}" IsReadOnly="True" Watermark="not set"
                             KeyDown="OnGestureKeyDown" />
                    <Button Grid.Column="2" Content="Default" Command="{Binding UseDefaultCommand}" ToolTip.Tip="{Binding DefaultText}" />
                    <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Reset all to defaults" Command="{Binding ResetAllCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
