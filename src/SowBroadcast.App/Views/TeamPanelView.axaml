<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SowBroadcast.App.ViewModels"
             xmlns:controls="using:SowBroadcast.App.Controls"
             xmlns:conv="using:SowBroadcast.App.Converters"
             x:Class="SowBroadcast.App.Views.TeamPanelView"
             x:DataType="vm:TeamPanelViewModel">

  <Border Classes="card" Padding="12,10">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <Border Classes="cardTitle"><TextBlock Classes="h2" Text="{Binding Title}" /></Border>
          <Grid ColumnDefinitions="Auto,*,Auto,90" ColumnSpacing="8">
            <TextBlock Classes="label" VerticalAlignment="Center" Text="NAME" />
            <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Team name" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" Text="ABBR" />
            <TextBox Grid.Column="3" Text="{Binding Abbr}" Watermark="ABC" MaxLength="6" />
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
            <TextBlock Classes="label" VerticalAlignment="Center" Text="SCORE" />
            <NumericUpDown Grid.Column="1" Width="120" Minimum="0" Maximum="200" FormatString="0" Value="{Binding Score}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" Margin="8,0,0,0" Text="COLOUR" />
            <controls:ColorField Grid.Column="3" HorizontalAlignment="Left" MinWidth="170" Hex="{Binding ColourHex}" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
          <Border Classes="card" Width="84" Height="84" Padding="4" ClipToBounds="True" HorizontalAlignment="Center">
            <Image Source="{Binding LogoPath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=168}"
                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Border>
          <Button Content="Load Logo…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding LoadLogoCommand}" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Players}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlayerRowViewModel">
            <Grid ColumnDefinitions="56,2*,2*,1.3*" ColumnSpacing="8" IsVisible="{Binding IsShown}">
              <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Label}" />
              <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Name" />
              <controls:SearchableComboBox Grid.Column="2" ItemsSource="{Binding HeroNames}" SelectedItem="{Binding Hero}" NoneText="— Hero —" />
              <controls:SearchableComboBox Grid.Column="3" ItemsSource="{Binding RoleNames}" SelectedItem="{Binding Role}" NoneText="- Role -" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
