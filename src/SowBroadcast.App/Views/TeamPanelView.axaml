<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SowBroadcast.App.ViewModels"
             xmlns:controls="using:SowBroadcast.App.Controls"
             xmlns:conv="using:SowBroadcast.App.Converters"
             x:Class="SowBroadcast.App.Views.TeamPanelView"
             x:DataType="vm:TeamPanelViewModel">

  <Border Classes="card" Padding="14">
    <StackPanel Spacing="12">
      <Border Classes="cardTitle"><TextBlock Classes="h2" Text="{Binding Title}" /></Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="12">
          <TextBlock Grid.Row="0" Classes="label" VerticalAlignment="Center" Text="NAME" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Watermark="Team name" />

          <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Text="ABBREVIATION" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Abbr}" Watermark="ABC" MaxLength="6" />

          <TextBlock Grid.Row="2" Classes="label" VerticalAlignment="Center" Text="SCORE" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" MinWidth="130"
                         Minimum="0" Maximum="200" FormatString="0" Value="{Binding Score}" />

          <TextBlock Grid.Row="3" Classes="label" VerticalAlignment="Center" Text="TEAM COLOUR" />
          <controls:ColorField Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" MinWidth="170" Hex="{Binding ColourHex}" />
        </Grid>

        <StackPanel Grid.Column="1" Spacing="8">
          <Border Classes="card" Width="120" Height="120" Padding="6" ClipToBounds="True">
            <Image Source="{Binding LogoPath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=240}"
                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Border>
          <Button Content="Load Logo…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding LoadLogoCommand}" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Players}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlayerRowViewModel">
            <Grid ColumnDefinitions="64,2*,2*,1.3*" ColumnSpacing="8" IsVisible="{Binding IsShown}">
              <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Label}" />
              <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Name" />
              <controls:SearchableComboBox Grid.Column="2" ItemsSource="{Binding HeroNames}" SelectedItem="{Binding Hero}" NoneText="— Hero —" />
              <controls:SearchableComboBox Grid.Column="3" ItemsSource="{Binding RoleNames}" SelectedItem="{Binding Role}" NoneText="- Role -" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
