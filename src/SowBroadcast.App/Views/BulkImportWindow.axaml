<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SowBroadcast.App.ViewModels"
        xmlns:controls="using:SowBroadcast.App.Controls"
        x:Class="SowBroadcast.App.Views.BulkImportWindow"
        x:DataType="vm:BulkImportViewModel"
        Title="Bulk Import from Folders"
        Icon="avares://SOWBroadcast/Assets/Brand/app-icon-256.png"
        Width="860" Height="560" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Classes="primary" Content="Import" Command="{Binding ImportCommand}" IsEnabled="{Binding HasRows}" />
      <Button Content="Cancel" Click="OnCancel" />
    </StackPanel>

    <Border Classes="card" Padding="8">
      <Grid>
        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasRows}"
                   Text="No new pictures found. Put hero or map images into the Heroes and Maps folders of the Scoreboard folder, then open this again." />
        <ScrollViewer IsVisible="{Binding HasRows}">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BulkImportRow">
                <Grid ColumnDefinitions="Auto,60,220,*,200" ColumnSpacing="10" Margin="0,3">
                  <CheckBox Grid.Column="0" IsChecked="{Binding Include}" />
                  <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding Kind}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                  <TextBox Grid.Column="3" Text="{Binding Name}" />
                  <controls:SearchableComboBox Grid.Column="4" IsVisible="{Binding IsMap}"
                                               ItemsSource="{Binding $parent[ItemsControl].((vm:BulkImportViewModel)DataContext).ModeNames}"
                                               SelectedItem="{Binding Mode}" Placeholder="Mode" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </DockPanel>
</Window>
