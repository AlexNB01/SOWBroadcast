<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SowBroadcast.App.ViewModels"
             x:Class="SowBroadcast.App.Views.WaitingView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel Margin="0,12,0,0">
    <!-- Update (Waiting) is the one primary button of this view -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Reset this tab" Command="{Binding ResetWaitingCommand}" />
      <Button Classes="primary" Content="Update (Waiting)" MinWidth="170" Command="{Binding UpdateWaitingCommand}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,0,12,0">

        <!-- Row 1: where the videos are, and the ticker -->
        <Grid ColumnDefinitions="*,12,*">
          <Border Classes="card" Padding="14,10">
            <StackPanel Spacing="8">
              <Border Classes="cardTitle"><TextBlock Classes="h2" Text="WAITING VIDEOS (FOLDER)" /></Border>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Waiting.VideosFolderText}" IsReadOnly="True" IsEnabled="{Binding !Waiting.UseDefaultVideos}"
                         Watermark="Select a folder that contains videos" />
                <Button Grid.Column="1" Content="Browse…" Command="{Binding Waiting.BrowseVideosCommand}" />
              </Grid>
              <CheckBox Content="Use the default folder (Highlights)" IsChecked="{Binding Waiting.UseDefaultVideos}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="card" Padding="14,10">
            <StackPanel Spacing="8">
              <Border Classes="cardTitle"><TextBlock Classes="h2" Text="TICKER OVERRIDE" /></Border>
              <TextBox Text="{Binding Waiting.TickerOverride}" IsEnabled="{Binding Waiting.TickerOverrideEnabled}" Watermark="Custom ticker text…" />
              <CheckBox Content="Overwrite default ticker text" IsChecked="{Binding Waiting.TickerOverrideEnabled}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Row 2: the countdown, and the texts on the screens -->
        <Grid ColumnDefinitions="*,12,*">
          <Border Classes="card" Padding="14,10">
            <StackPanel Spacing="8">
              <Border Classes="cardTitle"><TextBlock Classes="h2" Text="COUNTDOWN" /></Border>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" HorizontalAlignment="Center">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <Button Content="− 30s" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="-30" />
                  <Button Content="− 1m" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="-60" />
                  <Button Content="− 3m" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="-180" />
                  <Button Content="− 5m" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="-300" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <!-- The one large teal surface of the app: the most important number -->
                  <Border Background="{DynamicResource SowBladeBrush}" CornerRadius="6" Padding="28,6">
                    <TextBlock Classes="result" FontSize="64" HorizontalAlignment="Center" Foreground="{DynamicResource SowNightBrush}"
                               Text="{Binding Waiting.TimerText}" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Button Classes="start" Width="48" Height="40" ToolTip.Tip="Start" Command="{Binding Waiting.StartTimerCommand}">
                      <Path Data="M 0,0 L 12,7 L 0,14 Z" Fill="White" />
                    </Button>
                    <Button Classes="pause" Width="48" Height="40" ToolTip.Tip="Pause" Command="{Binding Waiting.PauseTimerCommand}">
                      <Rectangle Width="12" Height="12" Fill="White" />
                    </Button>
                    <Button Classes="reset" Width="48" Height="40" ToolTip.Tip="Reset to the preset" Command="{Binding Waiting.ResetTimerCommand}">
                      <TextBlock Text="↺" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="White" />
                    </Button>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                  <Button Content="+ 30s" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="30" />
                  <Button Content="+ 1m" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="60" />
                  <Button Content="+ 3m" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="180" />
                  <Button Content="+ 5m" MinWidth="86" Command="{Binding Waiting.AdjustTimerCommand}" CommandParameter="300" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" HorizontalAlignment="Center" Text="Timer buttons act on the overlays immediately." />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="card" Padding="14,10">
            <StackPanel Spacing="8">
              <Border Classes="cardTitle"><TextBlock Classes="h2" Text="ON-SCREEN TEXTS" /></Border>
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <TextBlock Classes="label" VerticalAlignment="Center" Text="STARTING SOON" />
                <TextBox Grid.Column="1" Text="{Binding Waiting.TextStarting}" Watermark="STARTING SOON!" />
                <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Text="BE RIGHT BACK" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Waiting.TextBrb}" Watermark="BE RIGHT BACK!" />
                <TextBlock Grid.Row="2" Classes="label" VerticalAlignment="Center" Text="END SCREEN" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Waiting.TextEnd}" Watermark="THANK YOU FOR WATCHING" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Row 3: the match schedule that rotates over the video (Be Right Back) or stays (Starting Soon) -->
        <Border Classes="card" Padding="14,10">
          <StackPanel Spacing="8">
            <Border Classes="cardTitle"><TextBlock Classes="h2" Text="MATCH SCHEDULE" /></Border>
            <CheckBox Content="List upcoming matches and latest results on the waiting screens" IsChecked="{Binding Waiting.ScheduleEnabled}" />
            <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto,24,Auto,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8" IsEnabled="{Binding Waiting.ScheduleEnabled}">
              <TextBlock Classes="label" VerticalAlignment="Center" Text="MATCHES PER PAGE" />
              <NumericUpDown Grid.Column="1" MinWidth="90" Minimum="1" Maximum="8" FormatString="0" Value="{Binding Waiting.ScheduleRows}" />
              <TextBlock Grid.Column="3" Classes="label" VerticalAlignment="Center" Text="SECONDS PER PAGE" />
              <NumericUpDown Grid.Column="4" MinWidth="90" Minimum="5" Maximum="120" FormatString="0" Value="{Binding Waiting.ScheduleSeconds}" />
              <TextBlock Grid.Column="6" Classes="label" VerticalAlignment="Center" Text="VIDEO ALONE (SECONDS)" />
              <NumericUpDown Grid.Column="7" MinWidth="90" Minimum="10" Maximum="600" FormatString="0" Value="{Binding Waiting.ScheduleVideoSeconds}" />
              <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Text="STREAM LINK CONTAINS" />
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" Text="{Binding Waiting.ScheduleStreamFilter}" Watermark="e.g. twitch.tv/suomiow (empty = any link)" />
            </Grid>
            <CheckBox Content="Also list matches in which neither team is known yet" IsChecked="{Binding Waiting.ScheduleShowUnknown}" IsEnabled="{Binding Waiting.ScheduleEnabled}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Upcoming matches come from the SOWDraft link and are listed only when the match has a stream link in SOWDraft. The video plays alone for the set time; then Starting Soon shows the upcoming matches and Be Right Back the upcoming matches and the latest results (every finished match, streamed or not), a page at a time, before the video goes on." />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,10">
          <StackPanel Spacing="8">
            <Border Classes="cardTitle"><TextBlock Classes="h2" Text="SOCIALS" /></Border>
            <ItemsControl ItemsSource="{Binding Waiting.Socials}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SocialFieldViewModel">
                  <Grid ColumnDefinitions="110,*" ColumnSpacing="12" Margin="0,0,16,6">
                    <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Label}" />
                    <TextBox Grid.Column="1" Text="{Binding Text}" Watermark="{Binding Placeholder}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
