<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SowBroadcast.App.ViewModels"
             xmlns:controls="using:SowBroadcast.App.Controls"
             xmlns:conv="using:SowBroadcast.App.Converters"
             xmlns:views="using:SowBroadcast.App.Views"
             x:Class="SowBroadcast.App.Views.MatchView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel Margin="0,12,0,0">
    <views:LinkPanel DockPanel.Dock="Top" DataContext="{Binding Link}" Margin="0,0,0,10" />

    <!-- Format bar: how many maps and players are shown (hidden data is kept) -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="14,8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="label" VerticalAlignment="Center" Text="MAPS" />
        <NumericUpDown MinWidth="120" Minimum="1" Maximum="7" FormatString="0" Value="{Binding Match.MapsCount}" />
        <TextBlock Classes="label" VerticalAlignment="Center" Margin="12,0,0,0" Text="PLAYERS" />
        <NumericUpDown MinWidth="120" Minimum="1" Maximum="8" FormatString="0" Value="{Binding Match.PlayersCount}" />
      </StackPanel>
    </Border>

    <!-- Actions: Update is the one primary button of this view -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Reset" Command="{Binding ResetMatchCommand}" />
      <Button Content="Swap Teams" Command="{Binding SwapTeamsCommand}" />
      <Button Classes="primary" Content="Update" MinWidth="120" Command="{Binding UpdateMatchCommand}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <Grid ColumnDefinitions="*,12,*">
          <views:TeamPanelView DataContext="{Binding Match.Team1}" />
          <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />
          <views:TeamPanelView Grid.Column="2" DataContext="{Binding Match.Team2}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Match.Maps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MapCardViewModel">
              <Border Classes="card" Padding="10" Margin="0,0,10,10" IsVisible="{Binding IsShown}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Border Classes="cardTitle"><TextBlock Classes="h2" Text="{Binding Label}" /></Border>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PickOptions}" SelectedItem="{Binding SelectedPick}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PickOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <Border Width="176" Height="99" ClipToBounds="True" CornerRadius="4" Background="{DynamicResource SowNightBrush}">
                    <Panel>
                      <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" Text="TBA" />
                      <Image Source="{Binding MapImagePath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=352}"
                             Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Panel>
                  </Border>

                  <controls:SearchableComboBox ItemsSource="{Binding MapNames}" SelectedItem="{Binding Map}" NoneText="— Map —" />

                  <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                    <NumericUpDown MinWidth="0" Minimum="0" Maximum="200" FormatString="0" Value="{Binding T1}" />
                    <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="–" />
                    <NumericUpDown Grid.Column="2" MinWidth="0" Minimum="0" Maximum="200" FormatString="0" Value="{Binding T2}" />
                  </Grid>

                  <CheckBox Content="Completed" IsChecked="{Binding Completed}" />

                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Classes="label" VerticalAlignment="Center" Text="T1 BAN" />
                    <controls:SearchableComboBox Grid.Column="1" ItemsSource="{Binding HeroNames}" SelectedItem="{Binding T1Ban}" NoneText="— Hero —" />
                    <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Text="T2 BAN" />
                    <controls:SearchableComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HeroNames}" SelectedItem="{Binding T2Ban}" NoneText="— Hero —" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
