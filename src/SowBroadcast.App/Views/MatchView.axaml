<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SowBroadcast.App.ViewModels"
             xmlns:controls="using:SowBroadcast.App.Controls"
             xmlns:conv="using:SowBroadcast.App.Converters"
             xmlns:views="using:SowBroadcast.App.Views"
             x:Class="SowBroadcast.App.Views.MatchView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel Margin="0,12,0,0">
    <views:LinkPanel DockPanel.Dock="Top" DataContext="{Binding Link}" Margin="0,0,0,10" />

    <!-- Format bar: how many maps and players are shown (hidden data is kept) -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="14,8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="label" VerticalAlignment="Center" Text="MAPS" />
        <NumericUpDown MinWidth="120" Minimum="1" Maximum="7" FormatString="0" Value="{Binding Match.MapsCount}" />
        <TextBlock Classes="label" VerticalAlignment="Center" Margin="12,0,0,0" Text="PLAYERS" />
        <NumericUpDown MinWidth="120" Minimum="1" Maximum="8" FormatString="0" Value="{Binding Match.PlayersCount}" />
      </StackPanel>
    </Border>

    <!-- Actions: Update is the one primary button of this view -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Reset" Command="{Binding ResetMatchCommand}" />
      <Button Content="Swap Teams" Command="{Binding SwapTeamsCommand}" />
      <Button Classes="primary" Content="Update" MinWidth="120" Command="{Binding UpdateMatchCommand}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <Grid ColumnDefinitions="*,12,*">
          <views:TeamPanelView DataContext="{Binding Match.Team1}" />
          <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />
          <views:TeamPanelView Grid.Column="2" DataContext="{Binding Match.Team2}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Match.Maps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MapCardViewModel">
              <Border Classes="card" Padding="8,6" IsVisible="{Binding IsShown}">
                <Grid ColumnDefinitions="Auto,150,Auto,2*,Auto,Auto,Auto,*,Auto,*" ColumnSpacing="8">
                  <Border Classes="cardTitle" VerticalAlignment="Center"><TextBlock Classes="h2" Text="{Binding Label}" /></Border>
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding PickOptions}" SelectedItem="{Binding SelectedPick}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PickOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Border Grid.Column="2" Width="64" Height="36" ClipToBounds="True" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource SowNightBrush}">
                    <Panel>
                      <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Text="TBA" />
                      <Image Source="{Binding MapImagePath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=128}"
                             Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Panel>
                  </Border>

                  <controls:SearchableComboBox Grid.Column="3" VerticalAlignment="Center" ItemsSource="{Binding MapNames}" SelectedItem="{Binding Map}" NoneText="— Map —" />

                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <NumericUpDown Width="100" MinWidth="0" Minimum="0" Maximum="200" FormatString="0" Value="{Binding T1}" />
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="–" />
                    <NumericUpDown Width="100" MinWidth="0" Minimum="0" Maximum="200" FormatString="0" Value="{Binding T2}" />
                  </StackPanel>

                  <CheckBox Grid.Column="5" VerticalAlignment="Center" Content="Completed" IsChecked="{Binding Completed}" />

                  <TextBlock Grid.Column="6" Classes="label" VerticalAlignment="Center" Text="T1 BAN" />
                  <controls:SearchableComboBox Grid.Column="7" VerticalAlignment="Center" ItemsSource="{Binding HeroNames}" SelectedItem="{Binding T1Ban}" NoneText="— Hero —" />
                  <TextBlock Grid.Column="8" Classes="label" VerticalAlignment="Center" Text="T2 BAN" />
                  <controls:SearchableComboBox Grid.Column="9" VerticalAlignment="Center" ItemsSource="{Binding HeroNames}" SelectedItem="{Binding T2Ban}" NoneText="— Hero —" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
