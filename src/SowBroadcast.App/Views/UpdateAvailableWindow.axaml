<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SowBroadcast.App.Views.UpdateAvailableWindow"
        Title="Update available"
        Icon="avares://SOWBroadcast/Assets/Brand/app-icon-256.png"
        Width="520" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel>
    <StackPanel Margin="24,22,24,20" Spacing="12">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="UPDATE AVAILABLE" />
        <TextBlock x:Name="VersionText" Classes="result" FontSize="18" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="SizeText" Classes="muted" />

      <StackPanel x:Name="NotesBox" Spacing="4">
        <TextBlock Classes="label" Text="WHAT'S NEW" />
        <Border Classes="card" Padding="12,8" MaxHeight="200">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>

      <TextBlock x:Name="WarningText" Classes="muted" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button x:Name="LaterButton" Content="Remind me later" MinWidth="130" Click="OnLater" />
        <Button Classes="primary" Content="Install now" MinWidth="110" Click="OnInstall" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
