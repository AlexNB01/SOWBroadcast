<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SowBroadcast.App.ViewModels"
        xmlns:views="using:SowBroadcast.App.Views"
        x:Class="SowBroadcast.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SOW Broadcast"
        Icon="avares://SOWBroadcast/Assets/Brand/app-icon-256.png"
        Width="1400" Height="860" MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{DynamicResource SowNightBrush}">
      <MenuItem Header="_File">
        <MenuItem Header="_Load…" Command="{Binding LoadCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
        <MenuItem Header="_Restore previous match…" Click="OnRestoreMatch" />
        <MenuItem Header="_Profiles…" Click="OnProfiles" />
        <Separator />
        <MenuItem Header="_Quit" Click="OnQuit" InputGesture="Alt+F4" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" HotKey="Ctrl+Z" IsEnabled="{Binding CanUndo}" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" HotKey="Ctrl+Y" IsEnabled="{Binding CanRedo}" />
      </MenuItem>
      <MenuItem Header="_Customize">
        <MenuItem Header="Manage _Heroes…" Click="OnManageHeroes" />
        <MenuItem Header="Manage _Maps…" Click="OnManageMaps" />
        <MenuItem Header="Manage Game _Modes…" Click="OnManageModes" />
        <Separator />
        <MenuItem Header="_Bulk Import from Folders…" Click="OnBulkImport" />
        <Separator />
        <MenuItem Header="_Update hero and map list…" Click="OnUpdateAssetList" />
      </MenuItem>
      <MenuItem Header="_Preview">
        <MenuItem Header="_All overlays at once" Click="OnPreviewAll" />
        <Separator />
        <MenuItem Header="In-game _scoreboard" Tag="scoreboard.html" Click="OnPreview" />
        <MenuItem Header="Map _draft" Tag="MapDraft.html" Click="OnPreview" />
        <MenuItem Header="_Maps" Tag="maps.html" Click="OnPreview" />
        <MenuItem Header="Team _1 roster" Tag="team.html?side=1" Click="OnPreview" />
        <MenuItem Header="Team _2 roster" Tag="team.html?side=2" Click="OnPreview" />
        <MenuItem Header="S_tarting soon" Tag="waiting.html?mode=start" Click="OnPreview" />
        <MenuItem Header="_Be right back" Tag="waiting.html?mode=brb" Click="OnPreview" />
        <MenuItem Header="Thank _you for watching" Tag="waiting.html?mode=end" Click="OnPreview" />
        <MenuItem Header="S_tandings" Tag="standings.html" Click="OnPreview" />
        <MenuItem Header="Brac_ket" Tag="bracket.html" Click="OnPreview" />
        <MenuItem Header="Duo camera _row" Tag="duorow.html" Click="OnPreview" />
        <MenuItem Header="Trio camera r_ow" Tag="triorow.html" Click="OnPreview" />
        <MenuItem Header="Single _camera" Tag="singlecam.html" Click="OnPreview" />
        <MenuItem Header="Instant _replay" Tag="replay.html" Click="OnPreview" />
        <MenuItem Header="Trans_ition" Tag="transition.html" Click="OnPreview" />
      </MenuItem>
      <MenuItem Header="C_ontrol">
        <MenuItem Header="_OBS panel…" Click="OnObsPanel" />
        <MenuItem Header="_Hotkeys, remote control and automation…" Click="OnControlSettings" />
      </MenuItem>
      <MenuItem x:Name="DebugMenu" Header="_Debug" IsVisible="False">
        <MenuItem Header="_Publish current state (Update)" Command="{Binding PublishNowCommand}" />
        <MenuItem Header="Load _sample match" Command="{Binding LoadSampleCommand}" />
        <Separator />
        <MenuItem Header="Open _scoreboard overlay in browser" Click="OnOpenScoreboardOverlay" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About SOW Broadcast…" Click="OnAbout" />
        <MenuItem Header="Check for _updates…" Click="OnCheckUpdates" />
        <MenuItem x:Name="UpdateStartupItem" Header="Check for updates when the program _starts" ToggleType="CheckBox" Click="OnUpdateStartupToggled" />
        <Separator />
        <MenuItem Header="Open _log folder" Click="OnOpenLogs" />
        <MenuItem Header="Open _data folder" Click="OnOpenData" />
      </MenuItem>
      <MenuItem Header="_Teams">
        <MenuItem Header="Team _library…" Click="OnTeamLibrary" />
        <Separator />
        <MenuItem Header="Keep _Home in the library" Command="{Binding SaveHomeToLibraryCommand}" />
        <MenuItem Header="Keep _Away in the library" Command="{Binding SaveAwayToLibraryCommand}" />
        <Separator />
        <MenuItem Header="Team _files">
          <MenuItem Header="Export _Home to file…" Command="{Binding ExportHomeCommand}" />
          <MenuItem Header="Import H_ome from file…" Command="{Binding ImportHomeCommand}" />
          <Separator />
          <MenuItem Header="Export _Away to file…" Command="{Binding ExportAwayCommand}" />
          <MenuItem Header="Import A_way from file…" Command="{Binding ImportAwayCommand}" />
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Header band: brand gradient (top to bottom), Tunnus mark, title -->
    <Border DockPanel.Dock="Top" Classes="header" Padding="18,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="avares://SOWBroadcast/Assets/Brand/tunnus-512.png" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="SOW BROADCAST" />
          <TextBlock Classes="muted" Foreground="{DynamicResource SowWhiteBrush}" Opacity="0.85" Text="Suomi OW ry – broadcast control" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="pill" IsVisible="{Binding HasUnsentChanges}">
            <TextBlock Text="Unsent changes" FontWeight="SemiBold" />
          </Border>
          <Border Classes="pill" IsVisible="{Binding HasActiveProfile}">
            <TextBlock Text="{Binding ActiveProfileName, StringFormat='Profile: {0}'}" FontWeight="SemiBold" />
          </Border>
          <Border Classes="pill">
            <TextBlock Text="{Binding Link.PillText}" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24">
          <TextBlock Classes="muted" Text="{Binding ServerStatus}" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding Version, StringFormat='Version {0}'}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Margin="14,10,14,10">
      <TabItem Header="MATCH">
        <views:MatchView />
      </TabItem>
      <TabItem Header="GENERAL">
        <views:GeneralView />
      </TabItem>
      <TabItem Header="WAITING SCREEN">
        <views:WaitingView />
      </TabItem>
      <TabItem Header="STANDINGS">
        <views:StandingsView />
      </TabItem>
      <TabItem Header="BRACKET">
        <views:BracketView />
      </TabItem>
      <TabItem x:Name="ThemeTab" Header="THEME" IsVisible="False">
        <views:ThemePreview x:Name="ThemeView" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
