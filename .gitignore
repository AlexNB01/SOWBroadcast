# Live app state — rewritten on every Update/autosave, not source content.
/match.json
/autosave.json
/assets.json

# OBS text/image-source export tree — regenerated in full on every Update().
Scoreboard/Match/
Scoreboard/General/*.txt
Scoreboard/General/OverlayLogo.png
Scoreboard/General/TransitionLogo.png
Scoreboard/Waiting/*.txt
Scoreboard/Waiting/*.json
Scoreboard/Waiting/Playlist/
Scoreboard/Replay/*.txt
Scoreboard/Replay/Playlist/
Scoreboard/Standings/
Scoreboard/Bracket/
Scoreboard/TournamentLogos/
Scoreboard/__last_gui_touch.txt

# Asset catalogues: index.json is the shipped catalogue of heroes/maps/modes (tracked, read by the 3.x app);
# index.txt is a generated name list.
Scoreboard/Maps/index.txt
Scoreboard/Heroes/index.txt
Scoreboard/Gametypes/index.txt

# Scratch staging area for logos/maps the user is about to import.
Scoreboard/Temp/

# Python / PyInstaller build output.
__pycache__/
*.pyc
*$py.class
/build/
/dist/

# Compiled Inno Setup installer output (regenerated by ISCC from install.iss).
/installer/

# Music library shipped by the installer but not tracked in the repo.
/Music/

# Virtual environments.
.venv/
venv/

# Logs and editor/OS cruft.
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# .NET 3.x rebuild
src/**/bin/
src/**/obj/
src/.vs/
*.user
TestResults/

# Installer build output (tools/build-installer.ps1).
/artifacts/
