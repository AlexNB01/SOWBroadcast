<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for SOW Broadcast: copy it into the project's "Artifact configurations" in SignPath
  (set it as the default). The release workflow uploads a ZIP (a GitHub artifact) that holds the setup program; this signs it.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="SOWBroadcast-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
